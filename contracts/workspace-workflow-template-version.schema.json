{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radishmind.local/contracts/workspace-workflow-template-version.schema.json",
  "title": "Workspace Workflow Template Version v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "version", "template_digest", "candidate_id", "candidate_review_version", "source_application_id", "source_owner_subject_ref", "source_definition_id", "source_definition_version", "source_definition_digest", "title", "summary", "usage_notes", "labels", "portability", "created_at", "created_by_actor_ref", "request_id", "audit_ref"],
  "properties": {
    "schema_version": {"const": "workspace_workflow_template_version.v1"},
    "template_id": {"$ref": "#/$defs/id"},
    "version": {"type": "integer", "minimum": 1},
    "template_digest": {"$ref": "#/$defs/digest"},
    "candidate_id": {"$ref": "#/$defs/id"},
    "candidate_review_version": {"const": 1},
    "source_application_id": {"type": "string", "pattern": "^app_[a-z2-7]{16}$"},
    "source_owner_subject_ref": {"type": "string", "minLength": 1, "maxLength": 240},
    "source_definition_id": {"$ref": "#/$defs/id"},
    "source_definition_version": {"type": "integer", "minimum": 1},
    "source_definition_digest": {"$ref": "#/$defs/digest"},
    "title": {"type": "string", "minLength": 2, "maxLength": 120},
    "summary": {"type": "string", "minLength": 4, "maxLength": 1000},
    "usage_notes": {"type": "string", "maxLength": 2000},
    "labels": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,39}$"}},
    "portability": {"$ref": "#/$defs/portability"},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by_actor_ref": {"type": "string", "minLength": 1, "maxLength": 240},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "audit_ref": {"type": "string", "minLength": 1, "maxLength": 240}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "portability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_profile", "node_kinds", "provider_refs", "risk_level", "portable", "blockers"],
      "properties": {
        "execution_profile": {"const": "workflow_definition_executor_v1"},
        "node_kinds": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["prompt", "llm", "condition", "output"]}},
        "provider_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^profile:[A-Za-z0-9][A-Za-z0-9._:-]{0,151}$"}},
        "risk_level": {"enum": ["low", "medium", "high"]},
        "portable": {"const": true},
        "blockers": {"type": "array", "maxItems": 0}
      }
    }
  }
}
