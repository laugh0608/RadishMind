{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radishmind.local/contracts/development-sdk-worker.schema.json",
  "description": "可信 Go 与受限 SDK 子进程的私有管道合同。输入凭据只走 stdin；stdout 仅元数据和工具提议，不是公共 API 或 SDK 自报授权。Go/Python 补充 UTF-8 字节、连续序号、作用域与因果校验。",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/message"
    },
    {
      "$ref": "#/$defs/reply"
    }
  ],
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "attempt_id",
        "executor_instance_id",
        "channel_url",
        "credential",
        "model",
        "initial_messages",
        "tools",
        "max_output_tokens",
        "max_model_calls"
      ],
      "properties": {
        "schema_version": {
          "const": "development_worker_input.v1"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}(?![\\s\\S])"
        },
        "executor_instance_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}(?![\\s\\S])"
        },
        "channel_url": {
          "type": "string",
          "maxLength": 128
        },
        "credential": {
          "type": "string",
          "pattern": "^devtask_[A-Za-z0-9_-]{43}(?![\\s\\S])"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "initial_messages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "content"
              ],
              "properties": {
                "role": {
                  "const": "system"
                },
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role",
                "content"
              ],
              "properties": {
                "role": {
                  "const": "user"
                },
                "content": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536
                }
              }
            }
          ]
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object"
          }
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "max_model_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "sequence",
        "kind",
        "event_type",
        "request_id"
      ],
      "properties": {
        "schema_version": {
          "const": "development_worker_message.v1"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "kind": {
          "enum": [
            "ready",
            "event",
            "tool",
            "finished",
            "failed"
          ]
        },
        "event_type": {
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{2,63}(?![\\s\\S])"
            }
          ]
        },
        "call": {
          "$ref": "development-tool-call.schema.json"
        },
        "error_code": {
          "enum": [
            "sdk_runtime",
            "generate_options",
            "message_serialization",
            "model_channel",
            "response_conversion",
            "tool_exchange",
            "sdk_type_error",
            "sdk_attribute_error",
            "sdk_validation_error"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "ready",
                  "finished"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "event_type": {
                "const": ""
              },
              "request_id": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "event"
              }
            }
          },
          "then": {
            "properties": {
              "event_type": {
                "enum": [
                  "system_prompt",
                  "user_message",
                  "assistant_message",
                  "action",
                  "observation",
                  "error",
                  "security"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "event_type": {
                "enum": [
                  "input",
                  "agent_setup",
                  "conversation_setup",
                  "run",
                  "close"
                ]
              },
              "request_id": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tool"
              }
            }
          },
          "then": {
            "required": [
              "call"
            ],
            "properties": {
              "event_type": {
                "const": ""
              },
              "request_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{2,63}(?![\\s\\S])"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "call"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "event"
              },
              "event_type": {
                "const": "error"
              }
            }
          },
          "then": {
            "required": [
              "error_code"
            ]
          },
          "else": {
            "not": {
              "required": [
                "error_code"
              ]
            }
          }
        }
      ]
    },
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "sequence",
        "request_id",
        "observation"
      ],
      "properties": {
        "schema_version": {
          "const": "development_worker_reply.v1"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,63}(?![\\s\\S])"
        },
        "observation": {
          "type": "string",
          "maxLength": 65536
        }
      }
    }
  }
}
