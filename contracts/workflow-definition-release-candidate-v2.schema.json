{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radishmind.local/contracts/workflow-definition-release-candidate-v2.schema.json",
  "title": "Workflow Definition Release Candidate v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "definition_id", "source_draft_id", "source_draft_version", "source_draft_digest", "definition_digest", "snapshot", "activation_eligible", "eligibility_blockers", "state", "review_version", "reviews", "created_at", "updated_at", "created_by_actor_ref", "updated_by_actor_ref", "request_id", "audit_ref"],
  "properties": {
    "schema_version": {"const": "workflow_definition_release_candidate.v2"},
    "candidate_id": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
    "definition_id": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
    "source_draft_id": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
    "source_draft_version": {"type": "integer", "minimum": 1},
    "source_draft_digest": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/digest"},
    "definition_digest": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/digest"},
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "activation_eligible": {"type": "boolean"},
    "eligibility_blockers": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "state": {"enum": ["pending", "approved", "rejected", "superseded"]},
    "review_version": {"type": "integer", "minimum": 0},
    "reviews": {"type": "array", "maxItems": 100, "items": {"$ref": "workflow-definition-release-decision.schema.json"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "created_by_actor_ref": {"type": "string", "minLength": 1, "maxLength": 240},
    "updated_by_actor_ref": {"type": "string", "minLength": 1, "maxLength": 240},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "audit_ref": {"type": "string", "minLength": 1, "maxLength": 240}
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "name", "description", "nodes", "edges", "input_contract", "output_contract", "provider_refs", "tool_refs", "rag_refs", "requested_capabilities", "execution_profile"],
      "properties": {
        "schema_version": {"const": "saved_workflow_draft.v2"},
        "name": {"type": "string", "minLength": 1, "maxLength": 4000},
        "description": {"type": "string", "maxLength": 4000},
        "nodes": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/node"}},
        "edges": {"type": "array", "maxItems": 120, "items": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/edge"}},
        "input_contract": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/structured_input_contract"},
        "output_contract": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/output_contract"},
        "provider_refs": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/string_list"},
        "tool_refs": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/string_list"},
        "rag_refs": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/string_list"},
        "requested_capabilities": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/string_list"},
        "execution_profile": {"const": "workflow_definition_executor_v2"}
      }
    }
  }
}
