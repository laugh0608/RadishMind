{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radishmind.local/contracts/workspace-workflow-template-audit.schema.json",
  "title": "Workspace Workflow Template Audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "resource_kind", "resource_id", "action", "actor_ref", "created_at", "request_id", "audit_ref"],
  "properties": {
    "schema_version": {"const": "workspace_workflow_template_audit.v1"},
    "audit_id": {"$ref": "#/$defs/id"},
    "resource_kind": {"enum": ["candidate", "version", "lineage"]},
    "resource_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "action": {"enum": ["create", "review_approve", "review_reject", "review_request_changes", "review_withdraw", "materialize", "list", "replace", "unlist"]},
    "actor_ref": {"type": "string", "minLength": 1, "maxLength": 240},
    "created_at": {"type": "string", "format": "date-time"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 240},
    "audit_ref": {"type": "string", "minLength": 1, "maxLength": 240}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"}}
}
