{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radishmind.local/contracts/application-result-artifact-export.schema.json",
  "title": "Application Result Artifact Export v1",
  "description": "单个不可变应用结果资产及其读取时生命周期的即时受控导出；导出文档不持久化，也不表示公开分享。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact", "lifecycle", "exported_at", "exported_by_actor_ref", "request_id", "audit_ref", "export_digest"],
  "properties": {
    "schema_version": {"const": "application_result_artifact_export.v1"},
    "artifact": {"$ref": "application-result-artifact.schema.json"},
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "tenant_ref", "workspace_id", "application_id", "owner_subject_ref", "artifact_id", "lifecycle_state", "lifecycle_version", "archived_at", "updated_at", "updated_by_actor_ref", "request_id", "audit_ref"],
      "properties": {
        "schema_version": {"const": "application_result_artifact_lifecycle.v1"},
        "tenant_ref": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
        "workspace_id": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
        "application_id": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
        "owner_subject_ref": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
        "artifact_id": {"type": "string", "pattern": "^appres_[a-z2-7]{16}$"},
        "lifecycle_state": {"enum": ["active", "archived"]},
        "lifecycle_version": {"type": "integer", "minimum": 1},
        "archived_at": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "format": "date-time"}
          ]
        },
        "updated_at": {"type": "string", "format": "date-time"},
        "updated_by_actor_ref": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
        "request_id": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
        "audit_ref": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"}
      }
    },
    "exported_at": {"type": "string", "format": "date-time"},
    "exported_by_actor_ref": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
    "request_id": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
    "audit_ref": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
    "export_digest": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/digest"}
  }
}
