{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radishmind.local/contracts/workflow-run-record-v9.schema.json",
  "title": "WorkflowRunRecordV9",
  "description": "Definition-bound controlled HTTP Tool run evidence. The record persists immutable authority, reviewed plan and confirmation references, bounded side-effect counters, and the sanitized tool projection; it never persists raw input, prompts, model answers, raw provider or HTTP responses, credentials, tokens, headers, node output previews, or final output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_version", "run_id", "plan_id", "confirmation_id", "tenant_ref",
    "draft_id", "draft_version", "workspace_id", "application_id", "execution_kind",
    "execution_source_kind", "execution_source_id", "execution_source_version", "execution_profile",
    "input_digest", "definition_authority", "status", "failure_code", "failure_summary", "started_at",
    "completed_at", "input_bytes", "condition_node_ids", "requested_model", "selected_provider",
    "selected_profile", "selected_model", "upstream_model", "selection_source", "nodes", "tool_attempt",
    "output", "request_id", "audit_ref", "actor_ref", "side_effects", "diagnostic"
  ],
  "properties": {
    "schema_version": {"const": "workflow_run_record.v9"},
    "record_version": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "pattern": "^run_[a-z0-9]{16,64}$"},
    "plan_id": {"type": "string", "pattern": "^wtap_[a-z0-9]{16,64}$"},
    "confirmation_id": {"type": "string", "pattern": "^wtcd_[a-z0-9]{16,64}$"},
    "tenant_ref": {"$ref": "#/$defs/reference"},
    "draft_id": {"const": ""},
    "draft_version": {"const": 0},
    "workspace_id": {"$ref": "#/$defs/scoped_id"},
    "application_id": {"$ref": "#/$defs/scoped_id"},
    "execution_kind": {"const": "workflow_definition_http_tool_execution"},
    "execution_source_kind": {"const": "workflow_definition"},
    "execution_source_id": {"$ref": "#/$defs/scoped_id"},
    "execution_source_version": {"type": "integer", "minimum": 1},
    "execution_profile": {"const": "workflow_definition_http_tool_v1"},
    "input_digest": {"$ref": "#/$defs/digest"},
    "definition_authority": {"$ref": "#/$defs/authority"},
    "status": {"enum": ["running", "succeeded", "failed", "canceled", "outcome_unknown"]},
    "failure_code": {"type": "string", "maxLength": 120},
    "failure_summary": {"type": "string", "maxLength": 256},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "maxLength": 64},
    "input_bytes": {"type": "integer", "minimum": 1, "maximum": 8192},
    "condition_node_ids": {"type": "array", "maxItems": 0},
    "requested_model": {"$ref": "#/$defs/safe_string"},
    "selected_provider": {"$ref": "#/$defs/safe_string"},
    "selected_profile": {"$ref": "#/$defs/safe_string"},
    "selected_model": {"$ref": "#/$defs/safe_string"},
    "upstream_model": {"$ref": "#/$defs/safe_string"},
    "selection_source": {"$ref": "#/$defs/safe_string"},
    "nodes": {"type": "array", "minItems": 4, "maxItems": 16, "items": {"$ref": "#/$defs/node"}},
    "tool_attempt": {"$ref": "#/$defs/tool_attempt"},
    "output": {"const": ""},
    "request_id": {"$ref": "#/$defs/reference"},
    "audit_ref": {"$ref": "#/$defs/reference"},
    "actor_ref": {"$ref": "#/$defs/reference"},
    "side_effects": {"$ref": "#/$defs/side_effects"},
    "diagnostic": {"$ref": "#/$defs/diagnostic"}
  },
  "$defs": {
    "reference": {"type": "string", "minLength": 3, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{2,159}$"},
    "scoped_id": {"type": "string", "minLength": 3, "maxLength": 120, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,119}$"},
    "safe_string": {"type": "string", "maxLength": 256, "not": {"pattern": "://"}},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_id", "definition_version", "definition_digest", "activation_pointer_version",
        "candidate_id", "candidate_review_version", "source_draft_id", "source_draft_version",
        "source_draft_digest", "application_record_version", "application_lifecycle"
      ],
      "properties": {
        "definition_id": {"$ref": "#/$defs/scoped_id"},
        "definition_version": {"type": "integer", "minimum": 1},
        "definition_digest": {"$ref": "#/$defs/digest"},
        "activation_pointer_version": {"type": "integer", "minimum": 1},
        "candidate_id": {"$ref": "#/$defs/scoped_id"},
        "candidate_review_version": {"type": "integer", "minimum": 1},
        "source_draft_id": {"$ref": "#/$defs/scoped_id"},
        "source_draft_version": {"type": "integer", "minimum": 1},
        "source_draft_digest": {"$ref": "#/$defs/digest"},
        "application_record_version": {"type": "integer", "minimum": 1},
        "application_lifecycle": {"const": "active"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id", "node_type", "label", "status", "started_at", "completed_at", "duration_ms",
        "predecessor_node_ids", "provider_ref", "output_preview", "failure_code"
      ],
      "properties": {
        "node_id": {"$ref": "#/$defs/scoped_id"},
        "node_type": {"enum": ["prompt", "http_tool", "llm", "output"]},
        "label": {"$ref": "#/$defs/safe_string"},
        "status": {"enum": ["pending", "running", "succeeded", "skipped", "failed"]},
        "started_at": {"type": "string", "maxLength": 64},
        "completed_at": {"type": "string", "maxLength": 64},
        "duration_ms": {"type": "integer", "minimum": 0},
        "predecessor_node_ids": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/scoped_id"}},
        "provider_ref": {"$ref": "#/$defs/safe_string"},
        "output_preview": {"const": ""},
        "failure_code": {"type": "string", "maxLength": 120}
      }
    },
    "tool_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id", "node_id", "tool_id", "definition_digest", "profile_id", "profile_digest",
        "tool_plan_digest", "confirmation_id", "status", "claimed_at", "completed_at", "http_status_class",
        "response_bytes", "duration_ms", "output_projection", "failure_code"
      ],
      "properties": {
        "attempt_id": {"type": "string", "pattern": "^wtea_[a-z0-9]{16,64}$"},
        "node_id": {"$ref": "#/$defs/scoped_id"},
        "tool_id": {"type": "string", "pattern": "^workflow\\.http\\.[a-z0-9][a-z0-9._-]*\\.v[0-9]+$"},
        "definition_digest": {"$ref": "#/$defs/digest"},
        "profile_id": {"type": "string", "pattern": "^workflow_http_profile_[a-z0-9_]{1,80}$"},
        "profile_digest": {"$ref": "#/$defs/digest"},
        "tool_plan_digest": {"$ref": "#/$defs/digest"},
        "confirmation_id": {"type": "string", "pattern": "^wtcd_[a-z0-9]{16,64}$"},
        "status": {"enum": ["claimed", "succeeded", "failed", "outcome_unknown"]},
        "claimed_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "maxLength": 64},
        "http_status_class": {"enum": ["", "2xx", "3xx", "4xx", "5xx"]},
        "response_bytes": {"type": "integer", "minimum": 0, "maximum": 65536},
        "duration_ms": {"type": "integer", "minimum": 0, "maximum": 30000},
        "output_projection": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "additionalProperties": {
            "oneOf": [
              {"type": "string", "maxLength": 4096, "not": {"pattern": "://"}},
              {"type": "number"},
              {"type": "boolean"},
              {"type": "null"}
            ]
          }
        },
        "failure_code": {"type": "string", "maxLength": 120}
      }
    },
    "side_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_calls", "tool_calls", "confirmation_calls", "business_writes", "replay_writes"],
      "properties": {
        "retrieval_calls": {"const": 0},
        "provider_calls": {"type": "integer", "minimum": 0, "maximum": 4},
        "tool_calls": {"const": 1},
        "confirmation_calls": {"const": 1},
        "business_writes": {"const": 0},
        "replay_writes": {"const": 0}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_boundary", "failure_stage", "failed_node_id", "last_completed_node_id", "terminal_write_state",
        "gateway_failure_category", "tool_failure_category", "summary", "recommended_review_action", "observed_at"
      ],
      "properties": {
        "failure_boundary": {"type": "string", "maxLength": 64},
        "failure_stage": {"type": "string", "maxLength": 64},
        "failed_node_id": {"type": "string", "maxLength": 160},
        "last_completed_node_id": {"type": "string", "maxLength": 160},
        "terminal_write_state": {"enum": ["pending", "stored"]},
        "gateway_failure_category": {"enum": ["none", "queue_full", "timeout", "canceled", "worker_crash", "protocol", "provider_failed", "output_unavailable", "unavailable", "quota"]},
        "tool_failure_category": {"type": "string", "maxLength": 64},
        "retrieval_failure_category": {"type": "string", "maxLength": 64},
        "summary": {"type": "string", "maxLength": 256},
        "recommended_review_action": {"type": "string", "maxLength": 64},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
