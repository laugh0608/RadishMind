{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radishmind.local/contracts/application-session-v4.schema.json",
  "title": "Application Session v4",
  "description": "Workflow Definition v2 结构化输入会话；只保存 exact authority、合同身份与生命周期元数据。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "tenant_ref", "workspace_id", "application_id", "owner_subject_ref", "state", "record_version", "profile_binding", "authority", "content_retention", "turn_count", "last_turn_id", "created_at", "updated_at", "closed_at", "created_by_actor_ref", "updated_by_actor_ref", "request_id", "audit_ref"],
  "properties": {
    "schema_version": {"const": "application_session.v4"},
    "session_id": {"type": "string", "pattern": "^appsess_[a-z2-7]{16}$"},
    "tenant_ref": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
    "workspace_id": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
    "application_id": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
    "owner_subject_ref": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
    "state": {"enum": ["active", "closed"]},
    "record_version": {"type": "integer", "minimum": 1},
    "profile_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_profile", "definition_id"],
      "properties": {
        "execution_profile": {"const": "workflow_definition_executor_v2"},
        "definition_id": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"}
      }
    },
    "authority": {"$ref": "application-runtime-authority-v4.schema.json"},
    "content_retention": {"const": "metadata_only"},
    "turn_count": {"type": "integer", "minimum": 0},
    "last_turn_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^appturn_[a-z2-7]{16}$"}]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "closed_at": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
    "created_by_actor_ref": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
    "updated_by_actor_ref": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
    "request_id": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"},
    "audit_ref": {"$ref": "saved-workflow-draft-v2.schema.json#/$defs/id"}
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "active"}}}, "then": {"properties": {"closed_at": {"type": "null"}}}},
    {"if": {"properties": {"state": {"const": "closed"}}}, "then": {"properties": {"closed_at": {"type": "string", "format": "date-time"}}}}
  ]
}
