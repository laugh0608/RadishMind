{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radishmind.local/contracts/gateway-request-record-v2.schema.json",
  "title": "GatewayRequestRecordV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_version",
    "store_mode",
    "request_id",
    "audit_ref",
    "tenant_ref",
    "workspace_id",
    "consumer_ref",
    "subject_ref",
    "route",
    "protocol",
    "stream",
    "status",
    "started_at",
    "completed_at",
    "duration_ms",
    "gateway_duration_ms",
    "gateway_duration_available",
    "provider_duration_ms",
    "provider_duration_available",
    "selection_source",
    "selected_provider",
    "selected_profile",
    "selected_model",
    "http_status_code",
    "failure_code",
    "failure_boundary",
    "usage",
    "cost_estimate"
  ],
  "properties": {
    "schema_version": { "const": "gateway_request_record.v2" },
    "record_version": { "type": "integer", "minimum": 0 },
    "store_mode": { "enum": ["memory_dev", "sqlite_dev", "postgres_dev_test"] },
    "request_id": { "$ref": "#/$defs/reference" },
    "audit_ref": { "$ref": "#/$defs/reference" },
    "tenant_ref": { "$ref": "#/$defs/reference" },
    "workspace_id": { "$ref": "#/$defs/reference" },
    "consumer_ref": { "type": "string", "maxLength": 256 },
    "application_id": { "$ref": "#/$defs/reference" },
    "subject_ref": { "$ref": "#/$defs/reference" },
    "route": { "type": "string", "minLength": 1, "maxLength": 160 },
    "protocol": { "type": "string", "minLength": 1, "maxLength": 96 },
    "stream": { "type": "boolean" },
    "status": { "enum": ["started", "succeeded", "failed", "canceled"] },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "gateway_duration_ms": { "type": "integer", "minimum": 0 },
    "gateway_duration_available": { "type": "boolean" },
    "provider_duration_ms": { "type": "integer", "minimum": 0 },
    "provider_duration_available": { "type": "boolean" },
    "selection_source": { "type": "string", "maxLength": 160 },
    "selected_provider": { "type": "string", "maxLength": 256 },
    "selected_profile": { "type": "string", "maxLength": 256 },
    "selected_model": { "type": "string", "maxLength": 256 },
    "provider_route_configuration_id": { "$ref": "#/$defs/reference" },
    "provider_route_generation": { "type": "integer", "minimum": 0 },
    "provider_route_snapshot_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "http_status_code": { "type": "integer", "minimum": 0, "maximum": 599 },
    "failure_code": { "type": "string", "maxLength": 160 },
    "failure_boundary": { "type": "string", "maxLength": 160 },
    "usage": { "$ref": "#/$defs/usage" },
    "cost_estimate": { "$ref": "gateway-request-cost-estimate.schema.json" }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "source", "input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "availability": { "enum": ["reported", "not_reported", "not_applicable"] },
        "source": { "type": "string", "maxLength": 96 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
