{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radishmind.local/contracts/workflow-run-record-v7.schema.json",
  "title": "WorkflowRunRecordV7",
  "description": "Agent / Copilot 受控建议的 metadata-only run；不保存上下文、artifact 内容、完整响应或 provider raw response。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_version", "run_id", "tenant_ref", "workspace_id", "application_id", "execution_kind", "execution_source_kind", "execution_source_id", "execution_source_version", "execution_profile", "authority", "project", "task", "locale", "input_digest", "input_bytes", "context_bytes", "artifact_count", "artifact_bytes", "requested_protocol", "selected_protocol", "requested_model", "selected_provider", "selected_profile", "selected_model", "upstream_model", "selection_source", "response_status", "response_digest", "answer_count", "issue_count", "action_count", "citation_count", "risk_level", "requires_confirmation", "status", "failure_code", "failure_summary", "started_at", "completed_at", "output", "usage", "side_effects", "diagnostic", "request_id", "audit_ref", "actor_ref"],
  "properties": {
    "schema_version": {"const": "workflow_run_record.v7"},
    "record_version": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "pattern": "^run_[a-z0-9]{16,64}$"},
    "tenant_ref": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/ref"},
    "workspace_id": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/ref"},
    "application_id": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/applicationId"},
    "execution_kind": {"const": "agent_copilot_suggestion"},
    "execution_source_kind": {"const": "agent_copilot_profile"},
    "execution_source_id": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/profileId"},
    "execution_source_version": {"type": "integer", "minimum": 1},
    "execution_profile": {"const": "agent_copilot_suggestion_v1"},
    "authority": {"$ref": "application-runtime-authority-v3.schema.json"},
    "project": {"enum": ["radishflow", "radish"]},
    "task": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/task"},
    "locale": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/locale"},
    "input_digest": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/digest"},
    "input_bytes": {"type": "integer", "minimum": 1, "maximum": 524288},
    "context_bytes": {"type": "integer", "minimum": 0, "maximum": 131072},
    "artifact_count": {"type": "integer", "minimum": 0, "maximum": 16},
    "artifact_bytes": {"type": "integer", "minimum": 0, "maximum": 262144},
    "requested_protocol": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/protocol"},
    "selected_protocol": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/protocol"},
    "requested_model": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/ref"},
    "selected_provider": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/ref"},
    "selected_profile": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/ref"},
    "selected_model": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/ref"},
    "upstream_model": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/ref"},
    "selection_source": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/ref"},
    "response_status": {"enum": ["unavailable", "ok", "partial", "failed"]},
    "response_digest": {"oneOf": [{"const": ""}, {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/digest"}]},
    "answer_count": {"type": "integer", "minimum": 0, "maximum": 64},
    "issue_count": {"type": "integer", "minimum": 0, "maximum": 64},
    "action_count": {"type": "integer", "minimum": 0, "maximum": 64},
    "citation_count": {"type": "integer", "minimum": 0, "maximum": 64},
    "risk_level": {"enum": ["low", "medium", "high"]},
    "requires_confirmation": {"type": "boolean"},
    "status": {"enum": ["running", "succeeded", "failed", "canceled", "outcome_unknown"]},
    "failure_code": {"type": "string", "maxLength": 160},
    "failure_summary": {"type": "string", "maxLength": 256},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "maxLength": 64},
    "output": {"const": ""},
    "usage": {"$ref": "#/$defs/usage"},
    "side_effects": {"$ref": "#/$defs/sideEffects"},
    "diagnostic": {"$ref": "#/$defs/diagnostic"},
    "request_id": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/ref"},
    "audit_ref": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/ref"},
    "actor_ref": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/ref"}
  },
  "allOf": [
    {
      "if": {"properties": {"project": {"const": "radishflow"}}, "required": ["project"]},
      "then": {"properties": {"task": {"enum": ["explain_diagnostics", "suggest_flowsheet_edits", "suggest_ghost_completion", "summarize_selection", "explain_control_plane_state", "inspect_canvas_snapshot"]}}}
    },
    {
      "if": {"properties": {"project": {"const": "radish"}}, "required": ["project"]},
      "then": {"properties": {"task": {"enum": ["answer_docs_question", "summarize_doc_or_thread", "suggest_forum_metadata", "explain_console_capability", "interpret_attachment"]}}}
    },
    {"if": {"properties": {"status": {"const": "running"}}}, "then": {"properties": {"completed_at": {"const": ""}, "failure_code": {"const": ""}, "failure_summary": {"const": ""}, "response_status": {"const": "unavailable"}, "response_digest": {"const": ""}}}},
    {"if": {"properties": {"status": {"const": "succeeded"}}}, "then": {"properties": {"completed_at": {"type": "string", "format": "date-time"}, "failure_code": {"const": ""}, "failure_summary": {"const": ""}, "response_status": {"enum": ["ok", "partial"]}, "response_digest": {"$ref": "agent-copilot-profile-draft.schema.json#/$defs/digest"}}}},
    {"if": {"properties": {"status": {"enum": ["failed", "canceled", "outcome_unknown"]}}}, "then": {"properties": {"completed_at": {"type": "string", "format": "date-time"}, "failure_code": {"type": "string", "minLength": 1, "maxLength": 160}}}}
  ],
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "state": {"enum": ["unavailable", "provider_reported"]},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "sideEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieval_calls", "provider_calls", "tool_calls", "confirmation_calls", "business_writes", "replay_writes"],
      "properties": {
        "retrieval_calls": {"const": 0},
        "provider_calls": {"type": "integer", "minimum": 0, "maximum": 1},
        "tool_calls": {"const": 0},
        "confirmation_calls": {"const": 0},
        "business_writes": {"const": 0},
        "replay_writes": {"const": 0}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_boundary", "failure_stage", "terminal_write_state", "gateway_failure_category", "summary", "recommended_review_action", "observed_at"],
      "properties": {
        "failure_boundary": {"type": "string", "maxLength": 64},
        "failure_stage": {"type": "string", "maxLength": 64},
        "terminal_write_state": {"enum": ["pending", "stored", "unknown"]},
        "gateway_failure_category": {"enum": ["none", "queue_full", "timeout", "canceled", "worker_crash", "protocol", "provider_failed", "output_unavailable", "unavailable"]},
        "summary": {"type": "string", "maxLength": 256},
        "recommended_review_action": {"type": "string", "maxLength": 64},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
