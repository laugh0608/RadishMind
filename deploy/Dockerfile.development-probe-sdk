# Optional SDK inspection image. Building it needs an explicit dependency window.
# It is separate from the validated workbench image and contains no model weights.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp/probe-home \
    XDG_CACHE_HOME=/tmp/probe-cache \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    OPENHANDS_SUPPRESS_BANNER=1 \
    LITELLM_LOCAL_MODEL_COST_MAP=True \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1
WORKDIR /opt/probe
COPY scripts/eval/development_probe/requirements-linux-arm64-py312.lock ./requirements.lock
RUN python -c 'import platform; assert platform.machine() == "aarch64", "candidate lock supports linux/arm64 only"' \
    && python -m pip install --no-cache-dir --only-binary=:all: --require-hashes \
        --no-deps --report /opt/probe/installation.json -r requirements.lock \
    && python -m pip check
COPY scripts/eval/development_probe/inspect_sdk.py scripts/eval/development_probe/fixed_endpoint.py scripts/eval/development_probe/test_sdk_contract.py ./
COPY contracts/development-task-probe-tool-request.schema.json ./tool-request.schema.json
USER 65532:65532
CMD ["python", "-c", "import importlib.metadata; import openhands.sdk; print(importlib.metadata.version('openhands-sdk'))"]
