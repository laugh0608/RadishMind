# Compose deployment settings only. Keep domain/model configuration in platform.json.
RADISHMIND_WORKBENCH_IMAGE=radishmind-workbench:local
# Replace with the source revision and append -dirty for modified sources.
RADISHMIND_WORKBENCH_BUILD_VERSION=local-workbench-unversioned
RADISHMIND_WORKBENCH_PORT=4100
RADISHMIND_WORKBENCH_CONFIG=./workbench/platform.json
RADISHMIND_WORKBENCH_DATA_DIR=./workbench/data
RADISHMIND_WORKBENCH_SECRETS_DIR=./workbench/secrets
# Set these to the owner of the prepared directories (for example, id -u / id -g).
RADISHMIND_WORKBENCH_UID=10001
RADISHMIND_WORKBENCH_GID=10001
