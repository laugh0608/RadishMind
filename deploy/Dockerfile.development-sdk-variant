# Optional source variant. Build only in an explicitly authorized dependency window.
# Context is prepared under repository tmp by prepare_sdk_variant.py.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS resolve
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /build
COPY build-requirements.lock constraints.txt lock_from_report.py source.json ./
RUN python -c 'import platform; assert platform.machine() == "aarch64"' \
    && python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r build-requirements.lock
COPY source/ ./source/
# --no-deps here builds just the wheel. Runtime dependencies are resolved normally
# below and are installed with dependency checking in the independent runtime stage.
RUN python -m pip wheel --no-cache-dir --no-build-isolation --no-deps ./source --wheel-dir /out/wheels \
    && python -m pip install --dry-run --ignore-installed --only-binary=:all: \
        --constraint constraints.txt --report /out/resolution.json \
        /out/wheels/openhands_sdk-1.59.0+radishmind.1-py3-none-any.whl \
    && python lock_from_report.py --report /out/resolution.json --output /out/requirements.lock \
        --sdk-wheel /out/wheels/openhands_sdk-1.59.0+radishmind.1-py3-none-any.whl \
    && python -m pip download --only-binary=:all: --require-hashes --find-links=/out/wheels \
        --dest /out/wheels -r /out/requirements.lock \
    && cp source.json /out/source.json

FROM scratch AS artifacts
COPY --from=resolve /out/ /

# A second build consumes the exported closure without resolving or downloading.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS runtime
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    HOME=/tmp/probe-home XDG_CACHE_HOME=/tmp/probe-cache \
    PIP_DISABLE_PIP_VERSION_CHECK=1 OPENHANDS_SUPPRESS_BANNER=1 \
    LITELLM_LOCAL_MODEL_COST_MAP=True HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 \
    OTEL_SDK_DISABLED=true
WORKDIR /opt/probe
COPY resolution/requirements.lock resolution/resolution.json resolution/source.json ./
COPY resolution/wheels/ /opt/wheels/
RUN --network=none python -c 'import platform; assert platform.machine() == "aarch64"' \
    && python -m pip install --no-index --find-links=/opt/wheels --require-hashes \
        --report /opt/probe/installation.json -r requirements.lock \
    && python -m pip check \
    && rm -rf /opt/wheels
COPY third-party/ /usr/local/share/radishmind/third-party/
COPY sdk_notice_delivery.py pip_notice_delivery.py ./
RUN --network=none python sdk_notice_delivery.py \
    --directory /usr/local/share/radishmind/third-party --installation-report /opt/probe/installation.json \
    && python pip_notice_delivery.py --directory /usr/local/share/radishmind/third-party/pip \
        --pip-root /usr/local/lib/python3.12/site-packages/pip \
        --metadata /usr/local/lib/python3.12/site-packages/pip-25.0.1.dist-info/METADATA
COPY inspect_sdk.py fixed_endpoint.py test_sdk_contract.py test_sdk_optional_laminar.py tool-request.schema.json ./
USER 65532:65532
CMD ["python", "/opt/probe/test_sdk_optional_laminar.py"]
